# FarField environment (example)

# Copy names into your shell. Do not commit a filled copy.
# The runtime reads the key from FARFIELD_LLM_KEY_FILE, never from this file.

FARFIELD_LLM_KEY_FILE=$HOME/.config/farfield/llm.key
FARFIELD_LLM_BASE_URL=https://api.deepseek.com/v1
FARFIELD_LLM_MODEL=deepseek-v4-pro

# Console (scripts/console.py). Keys travel over HTTP; default is loopback.
# FARFIELD_HOST=127.0.0.1
# PORT is 8765. From another machine, tunnel that port.

# Tests / recorded replay (no live calls)
# FARFIELD_LLM_MODE=replay
